#!/bin/sh
# Run archcheck from this checkout. Needs Python 3.10+; 3.11+ reads [tool.archcheck], so prefer the newest.
ROOT=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
for PY in python3.14 python3.13 python3.12 python3.11 python3; do
  command -v "$PY" >/dev/null 2>&1 && break
done
PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m archcheck "$@"
